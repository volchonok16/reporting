{
  "name": "dogtags-manager-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test:geometry": "playwright test tests/geometry",
    "test:e2e": "playwright test --config playwright.hub.config.ts tests/e2e tests/hub",
    "test:hub": "playwright test --config playwright.hub.config.ts tests/hub",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
