# Public ports
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CAROUSEL_CORS_ORIGINS=http://localhost:3000

# Upload/archive safety limits
CAROUSEL_MAX_UPLOAD_BYTES=8589934592
CAROUSEL_MAX_MASTER_ROWS=20000000
CAROUSEL_MAX_ARCHIVE_MEMBERS=20000
CAROUSEL_MAX_UNCOMPRESSED_BYTES=2147483648
CAROUSEL_MAX_COMPRESSION_RATIO=200

# Bounded background processing
CAROUSEL_JOB_WORKERS=2
CAROUSEL_PREVIEW_LIMIT=100

# Private object lifecycle
CAROUSEL_OBJECT_TTL_SECONDS=86400
CAROUSEL_CLEANUP_INTERVAL_SECONDS=300

# Первый локальный суперюзер. После первого запуска пароль можно сменить
# в личном кабинете.
CAROUSEL_AUTH_BOOTSTRAP_EMAIL=admin@t2.local
CAROUSEL_AUTH_BOOTSTRAP_PASSWORD=T2-Admin-2026!
CAROUSEL_AUTH_SESSION_SECONDS=43200

# Container limits (Compose)
API_MEMORY_LIMIT=1536m
API_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=1.0
