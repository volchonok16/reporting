FROM node:22-alpine AS dependencies

WORKDIR /srv/carousel
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG VOICE_BASE_PATH=/voice
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV VOICE_BASE_PATH=${VOICE_BASE_PATH}

COPY app ./app
COPY plugins ./plugins
COPY db ./db
COPY public ./public
COPY drizzle ./drizzle
COPY worker ./worker
COPY .openai ./.openai
COPY drizzle.config.ts eslint.config.mjs next.config.ts postcss.config.mjs tsconfig.json vite.config.ts ./
RUN npm run build

FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    VOICE_BASE_PATH=/voice

RUN addgroup -S -g 10001 carousel \
    && adduser -S -u 10001 -G carousel -H -s /sbin/nologin carousel

WORKDIR /srv/carousel
COPY --from=build --chown=carousel:carousel /srv/carousel ./

USER 10001:10001

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=8 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/voice/reporting-voice.txt').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["npm", "run", "start"]
