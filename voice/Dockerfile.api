FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system --gid 10001 carousel \
    && useradd --system --uid 10001 --gid carousel --home /nonexistent --shell /usr/sbin/nologin carousel

WORKDIR /srv/carousel

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --requirement /tmp/requirements.txt

COPY --chown=carousel:carousel backend ./backend
RUN mkdir -p /data \
    && chown carousel:carousel /data

USER 10001:10001

ENV CAROUSEL_DATA_DIR=/data \
    CAROUSEL_JOB_WORKERS=2 \
    CAROUSEL_OBJECT_TTL_SECONDS=86400 \
    CAROUSEL_CLEANUP_INTERVAL_SECONDS=300

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=8 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3).read()"]

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

