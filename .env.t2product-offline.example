# Прод HTTP: t2product.ru (без SSL)
#
#   cp .env.t2product-offline.example .env
#   # на Mac: bash scripts/offline-bundle.sh
#   # на сервере:
#   sudo bash scripts/offline-deploy.sh /tmp/reporting-offline.tar --with-nginx --t2product --tunnel
#
# DNS → IP сервера:
#   t2product.ru, www.t2product.ru, api.t2product.ru
#   minio.t2product.ru, minio-console.t2product.ru  (опционально)

POSTGRES_USER=reporting
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=reporting
TASKHUB_ALEX_PASSWORD=CHANGE_ME
TASKHUB_IVAN_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+psycopg://alex:CHANGE_ME@postgres:5432/reporting

APP_DOMAIN=t2product.ru
APP_PUBLIC_URL=http://t2product.ru
API_PUBLIC_URL=http://t2product.ru
CORS_ALLOW_ORIGINS=http://t2product.ru,http://www.t2product.ru,http://api.t2product.ru
CAROUSEL_CORS_ORIGINS=http://t2product.ru,http://www.t2product.ru,http://localhost:5173,http://localhost:3100
# Frontend same-origin на t2product.ru — VITE_API_URL не обязателен
VITE_API_URL=

BACKEND_WORKERS=2

APP_AUTH_USERS=sergey.balkovoy:CHANGE_ME
TFS_SYNC_PAT=CHANGE_ME

TFS_BASE_URL=https://tfs.t2.ru/tfs/Main
TFS_VERIFY_TLS=true

MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=photos
# Пусто = фото через /api/org/photos/ (удобно без отдельного DNS minio)
MINIO_PUBLIC_URL=

ORG_UPLOADS_DIR=/app/uploads
